# ALB/nginx terminate TLS; Apache only sees HTTP unless we trust X-Forwarded-Proto
<IfModule mod_setenvif.c>
	SetEnvIf X-Forwarded-Proto "https" HTTPS=on
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ index.php/$1 [L] 
	RewriteRule ^(.+).(d+).(js|css)$ $1.$3 [L]
	#RewriteCond %{HTTP_HOST} !=""
	#RewriteCond %{HTTP_HOST} !^www\. [NC]
	#RewriteCond %{HTTPS}s ^on(s)|
	#RewriteRule ^ https%1://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Skip redirect untuk localhost dan staging (development)
RewriteCond %{HTTP_HOST} ^localhost(:\d+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^127\.0\.0\.1(:\d+)?$ [NC,OR]
RewriteCond %{HTTP_HOST} ^staging\.authenticity\.id$ [NC]
RewriteRule ^ - [L]

# Production: HTTP → HTTPS (www)
RewriteCond %{HTTP_HOST} ^(www\.)?authenticity\.id$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://www.authenticity.id%{REQUEST_URI} [L,R=301]

# Production: apex → www (when already HTTPS via ALB)
RewriteCond %{HTTP_HOST} ^authenticity\.id$ [NC]
RewriteRule ^ https://www.authenticity.id%{REQUEST_URI} [L,R=301]	 
</IfModule>

ErrorDocument 404 /
